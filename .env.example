# @license GPL-3.0-or-later

# Runtime
NODE_ENV=development
SERVICE=ticket-service
PORT=4000
SCHEMA_TARGET=true
ENABLE_DEV_ENDPOINTS=false
COOKIE_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticket

# Kafka and Valkey
KAFKA_BROKER=localhost:9092
VALKEY_URL=valkey://localhost:6380
VALKEY_PASSWORD=

# QR token encryption and signing
# Generate each key with: openssl rand -base64 32
QR_JWE_KEY=replace-with-32-byte-base64-key
QR_JWS_KEYS={"v1":"replace-with-at-least-32-byte-base64-key"}
QR_ACTIVE_KID=v1

# Security/JWT verification
KC_URL=http://localhost:18080/auth
KC_REALM=camunda-platform
KC_CLIENT_ID=camunda-identity
KC_CLIENT_SECRET=
ENCRYPTION_KEY=replace-with-service-encryption-key

# Observability
TEMPO_URI=http://localhost:4318/v1/traces
LOG_LEVEL=debug
LOG_PRETTY=true

# Optional external readiness checks; leave empty to disable
KEYCLOAK_HEALTH_URL=
TEMPO_HEALTH_URL=
PROMETHEUS_HEALTH_URL=
